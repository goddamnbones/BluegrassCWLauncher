{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bluegrass Launcher",
  "version": "0.1.10",
  "identifier": "com.bluegrass.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Bluegrass Launcher",
        "width": 920,
        "height": 600,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBGOTU3MDlFMUY2RTU2RDEKUldUUlZtNGZubkNWRDRpVzhQR2ZMb2xsZU1rNzFzTTBzZ0szS21Bd2dvSXdXSWtEbkVoNW9tSkoK",
      "endpoints": ["https://github.com/goddamnbones/BluegrassCWLauncher/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
